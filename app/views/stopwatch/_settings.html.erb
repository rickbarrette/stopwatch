<p>
  <label for="settings_default_activity"><%= t '.label_default_activity' %> </label>
  <%= select_tag 'settings[default_activity]', options_from_collection_for_select( [['always_ask', t('.label_always_ask')], ['system', t('.label_system')]] + TimeEntryActivity.system.active.to_a.pluck(:id, :name), :first, :last, Stopwatch.settings['default_activity'] ) %>
</p>

<p>
  <label for="settings_max_timer_hours"><%= t '.label_max_timer_hours' %></label>
  <%= text_field_tag 'settings[max_timer_hours]', Stopwatch.settings['max_timer_hours'] || '10', size: 4, id: 'settings_max_timer_hours' %>
  <em class="info"><%= t '.text_max_timer_hours' %></em>
</p>

<p>
  <label for="settings_stop_time"><%= t '.label_stop_time' %></label>
  <%= time_field_tag 'settings[stop_time]', Stopwatch.settings['stop_time'], id: 'settings_stop_time' %>
  <em class="info"><%= t '.text_stop_time' %></em>
</p>

<p>
  <label for="settings_highlighted_links"><%= t '.label_highlighted_links' %> </label>
  <%= hidden_field_tag 'settings[highlighted_links]', '0', id: nil %>
  <%= check_box_tag 'settings[highlighted_links]', '1', Stopwatch.highlighted_links, id: 'settings_highlighted_links' %>
</p>